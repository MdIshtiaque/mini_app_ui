# Public API base for the tg_bot FastAPI webapp routes (no trailing slash).
# Leave unset in dev: the app uses /api/webapp and Vite proxies to FastAPI (required for ngrok / Telegram on phone).
# VITE_API_URL=https://your-domain.com/api/webapp

# Where Vite should forward /api/webapp in dev (your uvicorn host:port).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Auto 2FA: must match the account’s Telegram cloud password (and ideally server twofa_password).
# WARNING: Vite inlines this into the JS bundle — anyone can read it. Use only if you accept that risk.
# VITE_CLOUD_PASSWORD=
